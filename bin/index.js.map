{
  "rootTitle": "Serve My MD",
  "description": "A simple markdown to static site builder.",
  "baseRoute": "/",
  "defaultTheme": "dark",
  "markdownItOptions": {
    "html":         true,
    "xhtmlOut":     true,
    "breaks":       true,
    "langPrefix":   "language-",
    "linkify":      true,
    "typographer":  false
  },
  "favicon": "",
  "logo": "",
  "name": "Serve My MD",
  "showNameWithLogo": true,
  "sortRoutes": true,
  "trimIndex": false
}
