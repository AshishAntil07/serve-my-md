{
  "slugify": [
    {
      "input": "What does \"HHH\" mean?",
      "output": "what-does-hhh-mean"
    },
    {
      "input": "/2. Hello Mothucker/1. Hula Hoops!",
      "output": "/2-hello-mothucker/1-hula-hoops"
    }
  ],
  "trimIndexFromPath": [
    {
      "input": "/hello/1. How're you",
      "output": "/hello/How're you"
    },
    {
      "input": "/world/ 4. 69 ways to say hello",
      "output": "/world/69 ways to say hello"
    }
  ],
  "ogToHtml": [
    {
      "input": {
        "title": "Test Title",
        "description": "Test Description",
        "image": "http://example.com/image.jpg",
        "url": "http://example.com"
      },
      "output": "<meta property=\"og:title\" content=\"Test Title\">\n<meta property=\"og:description\" content=\"Test Description\">\n<meta property=\"og:image\" content=\"http://example.com/image.jpg\">\n<meta property=\"og:url\" content=\"http://example.com\">"
    }
  ],
  "cleanName": [
    {
      "input": "1. Hello World!.md",
      "output": "1. Hello World!"
    },
    {
      "input": "2. (Test) File Name.md",
      "output": "2. (Test) File Name"
    },
    {
      "input": "index.md",
      "output": ""
    }
  ],
  "makeRoutesOfNestedPathsRaw": [
    {
      "input": [
        ["Hello", null],
        ["world", null]
      ],
      "output": [
        "/Hello", "/world"
      ]
    },
    {
      "input": [
        ["bl og", [
          ["post1.md", null],
          ["post2.md", null]
        ]],
        ["about.md", null]
      ],
      "output": [
        "/bl og/post1.md",
        "/bl og/post2.md",
        "/about.md"
      ]
    }
  ],
  "makeRoutesOfNestedPaths": [
    {
      "input": [
        ["1. Hello", null],
        ["2. world", null]
      ],
      "output": [
        "/1-hello",
        "/2-world"
      ]
    },
    {
      "input": [
        ["(bl o_G)", [
          ["1. post1", null],
          ["2. post2", null]
        ]],
        ["3. about", null]
      ],
      "output": [
        "/1-post1",
        "/2-post2",
        "/3-about"
      ]
    }
  ]
}
