{
  "name": "serve-my-md",
  "version": "1.0.0",
  "type": "module",
  "description": "A utility to create a static build for your markdown files",
  "bin": "./bin/index.js",
  "repository": "https://github.com/AshishAntil07/serve-my-md",
  "author": "AshishAntil07 <ashishantil.antil07@gmail.com>",
  "license": "MIT",
  "packageManager": "yarn@4.12.0",
  "private": true,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "yarn build && vitest",
    "start": "node ./bin/index.js"
  },
  "volta": {
    "node": "24.11.1",
    "yarn": "4.12.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^24.10.1",
    "@types/prismjs": "^1",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "commander": "^14.0.3",
    "markdown-it": "^14.1.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-github-headings": "^2.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "minimatch": "^10.2.0",
    "prismjs": "^1.30.0"
  }
}
