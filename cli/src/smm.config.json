{
  "title": "Serve My MD",
  "description": "A simple markdown file to static site builder.",
  "baseRoute": "/",
  "defaultTheme": "dark",
  "markdownItOptions": {
    "html":         true,
    "xhtmlOut":     true,
    "breaks":       true,
    "langPrefix":   "language-",
    "linkify":      true,
    "typographer":  false
  }
}
