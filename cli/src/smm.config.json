{
  "rootTitle": "Serve My MD",
  "description": "A simple markdown to static site builder.",
  "baseRoute": "/",
  "defaultTheme": "dark",
  "markdownItOptions": {
    "html": true,
    "xhtmlOut": true,
    "breaks": true,
    "langPrefix": "language-",
    "linkify": true,
    "typographer": false
  },
  "outDir": "dist",
  "favicon": "",
  "logo": "",
  "name": "Serve My MD",
  "showNameWithLogo": true,
  "sortRoutes": true,
  "trimIndexFromPath": false
}
