{
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,

    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "declaration": true,

    // strictness
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    // module resolution
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../shared/*"]
    }
  },

  "include": ["src", "tests"],
  "exclude": [
    "out",
    ".yarn",
    "node_modules"
  ]
}
